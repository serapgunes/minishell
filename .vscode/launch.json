{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "(gdb) Launch",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/minishell",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}", // dosya dizininde başla
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": false
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": false
				},
				{
					"description": "Enable catchfork",
					"text": "catch fork",
					"ignoreFailures": false
				},
				{
					"description": "Follow child process",
					"text": "set follow-fork-mode child",
					"ignoreFailures": false
				},
				{
					"description": "Catch signals",
					"text": "handle SIGSEGV stop",
					"ignoreFailures": false
				}
			],
			"pipeTransport": {
				"pipeProgram": "bash",
				"pipeArgs": [
					"-c"
				],
				"debuggerPath": "/usr/bin/gdb"
			},
			"logging": {
				"engineLogging": true
			}
		}
	]
}